{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["idempotency_key","organization_id","initiative_id","update_id","expected_revision","health","summary","progress"],"properties":{"idempotency_key":{"type":"string","minLength":1,"maxLength":200},"organization_id":{"type":"string","minLength":1,"maxLength":512},"initiative_id":{"type":"string","minLength":1,"maxLength":512},"update_id":{"type":"string","minLength":1,"maxLength":512},"expected_revision":{"type":"string","pattern":"^[1-9][0-9]*$"},"health":{"$ref":"#/$defs/Health"},"summary":{"type":"string","minLength":1,"maxLength":4000},"progress":{"type":"integer","minimum":0,"maximum":100}},"$defs":{"Health":{"type":"string","enum":["on_track","at_risk","off_track","no_update"]}}}
