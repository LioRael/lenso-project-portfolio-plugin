{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["idempotency_key","organization_id","initiative_id","project_id","expected_membership_revision","name_snapshot","status_category","health","progress","target_start","target_date","snapshot_revision","observed_at"],"properties":{"idempotency_key":{"type":"string","minLength":1,"maxLength":200},"organization_id":{"type":"string","minLength":1,"maxLength":512},"initiative_id":{"type":"string","minLength":1,"maxLength":512},"project_id":{"type":"string","minLength":1,"maxLength":512},"expected_membership_revision":{"type":"string","pattern":"^[1-9][0-9]*$"},"name_snapshot":{"type":"string","minLength":1,"maxLength":240},"status_category":{"$ref":"#/$defs/Status"},"health":{"$ref":"#/$defs/Health"},"progress":{"type":"integer","minimum":0,"maximum":100},"target_start":{"type":["string","null"]},"target_date":{"type":["string","null"]},"snapshot_revision":{"type":"string","minLength":1,"maxLength":128},"observed_at":{"type":"string","format":"date-time"}},"$defs":{"Status":{"type":"string","enum":["backlog","planned","started","paused","completed","canceled"]},"Health":{"type":"string","enum":["on_track","at_risk","off_track","no_update"]}}}
